{
  "name": "mini-inference-router",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter gateway --filter console dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "kb:embed": "node --env-file-if-exists=.env scripts/embed_kb.ts",
    "calibrate": "node --env-file-if-exists=.env scripts/calibrate.ts",
    "eval:retrieval": "node --env-file-if-exists=.env scripts/eval-retrieval.ts",
    "eval": "node --env-file-if-exists=.env scripts/eval.ts",
    "eval:compare": "node scripts/eval-compare.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
